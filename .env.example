DATABASE_URL=              # Postgres connection string (Neon / Supabase / Aurora / local)

# Auth.js
AUTH_SECRET=                # generate with: npx auth secret
NEXTAUTH_URL=                # e.g. http://localhost:3000 in dev, your Vercel URL in prod
AUTH_ALLOWLIST=              # comma-separated emails permitted to sign in (MVP: just yours)

# Magic-link email (any SMTP provider — Resend, Postmark, SES, Gmail SMTP, ...).
# Omit these in local dev and the sign-in link is logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mind-Space Ledger <no-reply@example.com>

# AI analysis (Phase 2+, not yet wired up)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # e.g. a current Sonnet-class model id
