DATABASE_URL=              # Postgres connection string (Neon / Supabase / Aurora / local)

# Auth.js (v5 — note the AUTH_ prefix, not the old NEXTAUTH_ one)
AUTH_SECRET=                # generate with: npx auth secret
AUTH_URL=                   # optional: only needed behind a proxy that hides the real host.
                             # Auth.js already trusts the request host in dev and on Vercel.
AUTH_ALLOWLIST=              # comma-separated emails permitted to sign in (MVP: just yours)

# Email (any SMTP provider — Resend, Postmark, SES, Gmail SMTP, ...). Used for
# the "set/reset password" link (also how you set your password the first
# time — there's no separate signup flow). Omit these in local dev and the
# email content is logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mind-Space Ledger <no-reply@example.com>

# AI analysis (Phase 2+, not yet wired up)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # e.g. a current Sonnet-class model id
